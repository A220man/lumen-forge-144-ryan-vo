# Lumen Forge Environment Variables
# Copy to .env and fill in values

# Application
ENVIRONMENT=development
VERSION=1.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/lumen.db

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keycloak / OIDC
OIDC_ISSUER=http://localhost:8080/realms/lumen-forge
OIDC_CLIENT_ID=lumen-forge
OIDC_CLIENT_SECRET=dev-secret-change-in-production
OIDC_REDIRECT_URI=http://localhost:5173/callback

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# Demo mode (local only - REFUSES in production)
DEMO_MODE=true